# 数据模式：true=模拟数据，false=真实抓取
USE_MOCK_DATA=false

# X/Twitter 抓取镜像池（可选，不填则使用内置默认镜像池）
# X_NITTER_INSTANCES=https://nitter.perennialte.ch,https://nitter.poast.org,https://nitter.tiekoetter.com
# X_FEED_TIMEOUT_MS=8000

# 可选：已有的 RSSHub 服务，同样需要该服务能够访问 X
# USE_RSSHUB_X=true
# RSSHUB_BASE_URL=https://your-rsshub.example.com

# 如果使用真实抓取，配置代理（可选）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 或使用 Socks5 代理
# HTTP_PROXY=socks5://127.0.0.1:1080
# HTTPS_PROXY=socks5://127.0.0.1:1080
